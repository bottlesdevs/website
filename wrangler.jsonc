{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bottles-website",
  "account_id": "465ee9f2275f4add12c86ca32add6946",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "usebottles.com",
      "custom_domain": true
    },
    {
      "pattern": "www.usebottles.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
